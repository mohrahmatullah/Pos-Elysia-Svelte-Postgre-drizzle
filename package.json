{
  "name": "pos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --filter '@pos/api' dev",
    "dev:web": "bun run --filter '@pos/web' dev",
    "build:api": "bun run --filter '@pos/api' build",
    "build:web": "bun run --filter '@pos/web' build",
    "db:generate": "bun run --filter '@pos/api' db:generate",
    "db:migrate": "bun run --filter '@pos/api' db:migrate",
    "db:seed": "bun run --filter '@pos/api' db:seed",
    "db:studio": "bun run --filter '@pos/api' db:studio",
    "test": "bun run --filter '@pos/api' test",
    "typecheck": "bun run --filter '*' typecheck",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  }
}
